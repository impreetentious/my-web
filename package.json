{
  "name": "my-web",
  "version": "0.15.2",
  "private": true,
  "engines": {
    "node": "22.22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "prebuild": "node scripts/pull-content.mjs && node scripts/validate-content.mjs",
    "content": "node scripts/pull-content.mjs",
    "content:seed": "node scripts/seed-sanity.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "test": "npm run test:unit && node scripts/verify-placeholder-states.mjs && SANITY_PROJECT_ID= node scripts/pull-content.mjs && npm run build && npm run budget:bundle && npm run budget:performance && npm run test:e2e",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^1.7.0",
    "next": "15.5.14",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.8",
      "sharp": "^0.34.5"
    }
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Personal website for Sidakpreet Singh.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/my-web.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/my-web/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/my-web#"
}
