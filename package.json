{
  "name": "my-web",
  "version": "0.17.3",
  "private": true,
  "engines": {
    "node": "22.22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "prebuild": "node scripts/pull-content.mjs && node scripts/validate-content.mjs",
    "content": "node scripts/pull-content.mjs",
    "content:seed": "node scripts/validate-content.mjs && node scripts/seed-sanity.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "budget:performance": "node scripts/performance-budget.mjs",
    "budget:lighthouse": "lhci autorun",
    "test": "npm run test:unit && npm run build && npm run budget:bundle && npm run budget:performance && npm run test:e2e && node scripts/verify-placeholder-states.mjs",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "next-mdx-remote": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.184.0",
    "yaml": "^2.8.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "3.4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14",
      "sharp": "^0.34.5"
    },
    "tmp": "0.2.5",
    "uuid": "11.1.1"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Personal website for Sidakpreet Singh.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/my-web.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/my-web/issues"
  },
  "homepage": "https://sidakpreetsingh.com"
}
