{
  "name": "my-web",
  "version": "0.14.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "prebuild": "node scripts/pull-content.mjs && node scripts/validate-content.mjs",
    "content": "node scripts/pull-content.mjs",
    "content:seed": "node scripts/seed-sanity.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/verify-placeholder-states.mjs && SANITY_PROJECT_ID= node scripts/pull-content.mjs && npm run build && playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "@vercel/analytics": "^1.5.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.13",
    "lucide-react": "^0.552.0",
    "next": "15.5.6",
    "next-mdx-remote": "^5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.6"
    }
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Personal website for Sidakpreet Singh.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/my-web.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/my-web/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/my-web#"
